MOHANO_ENVIRONMENT=local
MOHANO_DATABASE_URL=mysql+pymysql://mohano:0000@127.0.0.1:3306/mohano?charset=utf8mb4
# Swagger is unauthenticated for local development. Dev/staging receive these
# values from Secret Manager and require the browser's Basic Auth prompt.
# MOHANO_DOCS_BASIC_AUTH_USERNAME=mohano-admin
# MOHANO_DOCS_BASIC_AUTH_PASSWORD=replace-with-a-10-character-password
# Cloud Run + entry Cloud SQL defaults. Keep the aggregate connection count low.
MOHANO_DATABASE_POOL_SIZE=3
MOHANO_DATABASE_MAX_OVERFLOW=1
MOHANO_DATABASE_POOL_TIMEOUT_SECONDS=30
MOHANO_JWT_SECRET_KEY=replace-with-a-long-random-secret
MOHANO_ACCESS_TOKEN_EXPIRE_MINUTES=15
MOHANO_REFRESH_TOKEN_EXPIRE_DAYS=30
# Google Cloud Console에서 만든 Web application OAuth client ID입니다.
# ID token의 audience 검증에만 사용하며 client secret은 서버에도 저장하지 않습니다.
MOHANO_GOOGLE_WEB_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com
# Apple native bundle ID and Android/web Service ID. Separate multiple values with commas.
# The Android/web flow also needs an HTTPS callback URL registered at Apple; see README.
MOHANO_APPLE_CLIENT_IDS=com.example.mohano,com.example.mohano.web
MOHANO_APPLE_ANDROID_PACKAGE_ID=com.example.mohano
# LINE Developers Console > LINE Login channel ID. No channel secret is used
# for the native ID token verification flow.
MOHANO_LINE_CHANNEL_ID=replace-with-your-line-login-channel-id
# Kakao Developers > My Application > App settings > App ID. This is not the
# REST API key; it binds the access token verified by the server to this app.
MOHANO_KAKAO_APP_ID=replace-with-your-kakao-app-id
# Firebase Admin service-account JSON is a secret. Keep it outside this
# repository and provide only its absolute path to the local/production server.
MOHANO_FCM_ENABLED=false
# Firebase Console project ID. Local development can use ADC instead of a
# long-lived service-account key, via `gcloud auth application-default login`.
MOHANO_FIREBASE_PROJECT_ID=mohano-512515
# MOHANO_FIREBASE_CREDENTIALS_PATH=C:\secure\mohano-firebase-admin.json
MOHANO_CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:8080
# Flutter web development ports are allowed by the local-only default regex in app/core/config.py.
# Override this value with explicit production origins before deployment.
MOHANO_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# Local Silo defaults are configured in app/core/config.py. Set every value below only for a
# different local endpoint or the production Cloudflare R2 environment.
# MOHANO_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
# MOHANO_OBJECT_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# MOHANO_OBJECT_STORAGE_ACCESS_KEY=mohano
# MOHANO_OBJECT_STORAGE_SECRET_KEY=00000000
# MOHANO_OBJECT_STORAGE_BUCKET=mohano-profile-images
